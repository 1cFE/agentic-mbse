# The adoption rehearsal's one environment file (design Appendix H3, "Environment control").
#
# Copy it to env.sh, fill in the path marked <...>, and keep env.sh out of git. Source it
# once, in the one shell that runs A, B and C in sequence on the one copy $FTC:
#
#   . env.sh && record_env "$RUN/A"     # then run A; the same for B and C
#
# The licence is loaded from the file that already holds it and is recorded by presence only:
# its value never appears here, in env.txt, or in any transcript.

# --- The licence (SYSIDE_LICENSE_KEY), from the companion checkout's .env. Only that one
# variable is taken: the file holds other credentials the rehearsal has no use for.
SYSIDE_LICENSE_KEY="$(set -a; . /home/reid/1cfe/agentic-mbse/.env; printf %s "${SYSIDE_LICENSE_KEY:-}")"
export SYSIDE_LICENSE_KEY
: "${SYSIDE_LICENSE_KEY:?SYSIDE_LICENSE_KEY is not set by /home/reid/1cfe/agentic-mbse/.env}"

# --- fusion-tea's own variables: the values its operator guide documents for .venv/integration.env.
# STOP_PARSER_WHEEL_TARGET names the site-packages of the interpreter that runs, which in the
# rehearsal is the disposable copy's venv, not the primary checkout's.
export FTC="<the disposable fusion-tea worktree at b06585709>"
export STOP_PARSER_WHEEL_TARGET="$FTC/.venv/lib/python3.12/site-packages"
export STOP_PARSER_AGENTIC_WHEEL=/home/reid/1cfe/stop-parser-sealed-wheels/agentic_mbse-0.1.3-py3-none-any.whl
export STOP_PARSER_CODEGEN_WHEEL=/home/reid/1cfe/stop-parser-sealed-wheels/sysml_codegen-0.1.1-py3-none-any.whl
export STOP_PARSER_COSTINGFE_WHEEL=/home/reid/1cfe/stop-parser-sealed-wheels/1costingfe-0.1.0-py3-none-any.whl
export STOP_PARSER_TEAX_ROOT=/home/reid/1cfe/teax

# --- The installed tools' teax root (B7): a simkit root, set for every run. Run A's tools never
# read it; runs B and C need it.
export TEAX_SIMKIT_PATH="$STOP_PARSER_TEAX_ROOT/packages/teax-simkit"

# --- Nothing inherited decides a project root. The wrappers pin fusion-tea's root in-process,
# and step 8c's driver command sets SYSML_CODEGEN_PROJECT_ROOT inline, for that command only.
unset SYSML_CODEGEN_PROJECT_ROOT
unset PYTHONPATH

# record_env RUN_DIR: write RUN_DIR/env.txt, the per-run record Appendix H3 asks for. It reads
# the copy's venv directly, so recording never creates or syncs one. Appendix H3's grep reads
# '^(STOP_PARSER_|...)=', which matches no STOP_PARSER_ name; the pattern below names them.
record_env() {
    mkdir -p "$1"
    {
        echo "# $(date -u +%Y-%m-%dT%H:%M:%SZ) in $FTC"
        "$FTC/.venv/bin/python" -V
        uv pip list --python "$FTC/.venv/bin/python"
        echo "teax HEAD $(git -C "$STOP_PARSER_TEAX_ROOT" rev-parse HEAD)"
        echo "SYSIDE_LICENSE_KEY=$([ -n "${SYSIDE_LICENSE_KEY:-}" ] && echo set || echo missing)"
        env | grep -E '^(STOP_PARSER_[A-Z_]*|TEAX_SIMKIT_PATH|SYSML_CODEGEN_PROJECT_ROOT|PYTHONPATH)=' | sort
    } > "$1/env.txt" 2>&1
}
