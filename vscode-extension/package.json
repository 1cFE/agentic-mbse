{
  "name": "file-native-comments",
  "displayName": "File-Native Comment System",
  "description": "Thread-based code comments stored in .comments/ directory with intelligent anchor reconciliation",
  "version": "0.1.0",
  "publisher": "agentic-mbse",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "file-native-comments.addComment",
        "title": "Add Comment",
        "category": "File-Native Comments"
      },
      {
        "command": "file-native-comments.replyNote",
        "title": "Reply to Comment",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "file-native-comments.resolveThread",
        "title": "Resolve Thread",
        "category": "File-Native Comments"
      },
      {
        "command": "file-native-comments.reopenThread",
        "title": "Reopen Thread",
        "category": "File-Native Comments"
      },
      {
        "command": "file-native-comments.focusThread",
        "title": "Go to Comment Thread",
        "category": "File-Native Comments"
      },
      {
        "command": "file-native-comments.reconcileFile",
        "title": "Reconcile File",
        "category": "File-Native Comments"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "file-native-comments.addComment",
          "group": "comments"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "file-native-comments.resolveThread",
          "group": "inline",
          "when": "commentThreadState == 'unresolved'"
        },
        {
          "command": "file-native-comments.reopenThread",
          "group": "inline",
          "when": "commentThreadState == 'resolved'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "file-native-comments.addComment",
        "key": "ctrl+k ctrl+m",
        "mac": "cmd+k cmd+m",
        "when": "editorTextFocus"
      },
      {
        "command": "file-native-comments.focusThread",
        "key": "ctrl+k ctrl+c",
        "mac": "cmd+k cmd+c",
        "when": "editorTextFocus"
      },
      {
        "command": "file-native-comments.reconcileFile",
        "key": "ctrl+k ctrl+r",
        "mac": "cmd+k ctrl+r",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.x",
    "jest": "^29.7.0",
    "prettier": "^3.x",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentic-mbse/comment-system"
  },
  "license": "MIT"
}
